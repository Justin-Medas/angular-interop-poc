{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx ng test shell --no-watch"
  },
  "mutate": [
    "projects/shell/src/app/modules/module-registry.ts",
    "projects/shell/src/app/modules/load.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": {
    "fileName": "reports/mutation/shell.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/shell.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  },
  "concurrency": 1,
  "timeoutMS": 60000,
  "disableTypeChecks": "projects/**/*.ts",
  "inPlace": true
}
