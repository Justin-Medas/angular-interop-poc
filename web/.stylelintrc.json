{
  "customSyntax": "postcss-scss",
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "function-disallowed-list": ["rgb", "rgba", "hsl", "hsla"],
    "custom-property-pattern": [
      "^poc-[a-z0-9-]+$",
      {
        "message": "Custom properties must be --poc-*"
      }
    ],
    "declaration-property-value-disallowed-list": {
      "/^(?!--)/": ["/\\d(px|rem|em|ms|s|vh|vw)\\b/"],
      "/^(font-weight|opacity|line-height|z-index)$/": ["/^[0-9.]+$/"]
    }
  },
  "overrides": [
    {
      "files": ["**/tokens.css"],
      "rules": {
        "color-no-hex": null,
        "color-named": null,
        "function-disallowed-list": null,
        "declaration-property-value-disallowed-list": null
      }
    }
  ]
}
