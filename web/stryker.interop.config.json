{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx ng test interop --no-watch"
  },
  "mutate": ["projects/interop/src/lib/*.ts", "!projects/interop/src/lib/*.spec.ts"],
  "coverageAnalysis": "off",
  "reporters": ["clear-text", "json", "html"],
  "jsonReporter": {
    "fileName": "reports/mutation/interop.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/interop.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  },
  "concurrency": 1,
  "timeoutMS": 60000,
  "disableTypeChecks": "projects/**/*.ts",
  "inPlace": true
}
